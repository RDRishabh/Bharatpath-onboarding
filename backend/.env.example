# Copy to .env for local development. NEVER commit a real .env - secrets come
# from AWS Secrets Manager in every deployed environment, injected as env vars
# and read once at boot.

ENVIRONMENT=local
DEBUG=true

# The app role has no BYPASSRLS and does not own the tables. That is what makes
# Row-Level Security the real second line of tenant isolation.
DATABASE_URL=postgresql+asyncpg://bharatpath_app:bharatpath_app@localhost:5432/bharatpath
DATABASE_ADMIN_URL=postgresql+asyncpg://bharatpath_admin:bharatpath_admin@localhost:5432/bharatpath

REDIS_URL=redis://localhost:6379/0

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

CELERY_BROKER_URL=sqs://

# Provisioned by whoever owns infrastructure. Blank locally.
COGNITO_CANDIDATE_POOL_ID=
COGNITO_BUSINESS_POOL_ID=
COGNITO_CANDIDATE_CLIENT_ID=
COGNITO_BUSINESS_CLIENT_ID=

# Twilio credentials for the OTP path live in the Cognito Lambda triggers,
# which are outside this codebase. Only the notification-SMS credentials are
# read here. See docs/plan.md section 5.8.
